[Unit]
Description=Nixe Passwords vault
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/nixe-passwordsd
Restart=on-failure
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=graphical-session.target
