[Desktop Entry]
Type=Application
Name=Passwords
GenericName=Password Manager
Comment=Your Vaultwarden vault: logins, one-time codes and secure notes
Exec=nixe-passwords
Icon=io.github.design_nexus.nixe.Passwords
Terminal=false
Categories=Utility;Security;GTK;
Keywords=password;vault;vaultwarden;bitwarden;login;totp;2fa;
StartupNotify=true
StartupWMClass=io.github.design_nexus.nixe.Passwords
SingleMainWindow=true
DBusActivatable=false
