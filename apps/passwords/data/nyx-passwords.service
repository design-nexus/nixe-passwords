[Unit]
Description=Nyx Passwords vault
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/nyx-passwordsd
Restart=on-failure
# 75: an update replaced the binary; start again on the new one.
SuccessExitStatus=75
RestartForceExitStatus=75
UMask=0077
LimitCORE=0
NoNewPrivileges=yes
LockPersonality=yes
RestrictRealtime=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=graphical-session.target
