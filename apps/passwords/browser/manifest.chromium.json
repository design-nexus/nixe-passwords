{
  "manifest_version": 3,
  "name": "Nyx Passwords",
  "description": "Logins, cards, addresses and passkeys from Nyx Passwords, your Vaultwarden vault on this computer.",
  "version": "0.4.0",
  "key": "",
  "minimum_chrome_version": "133",
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Nyx Passwords" },
  "permissions": ["nativeMessaging", "storage", "activeTab", "scripting", "tabs", "alarms", "contextMenus"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["menu.html", "menu.js", "bar.html", "bar.js", "nyx.js", "theme.css"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+Y" }, "description": "Open Nyx Passwords" },
    "fill-login": { "suggested_key": { "default": "Ctrl+Shift+L" }, "description": "Fill the login for this page (press again for the next)" },
    "generate-password": { "suggested_key": { "default": "Ctrl+Shift+9" }, "description": "Generate a password into this page" }
  },
  "icons": { "48": "icon-48.png", "128": "icon-128.png" }
}
